# AI LEARNING LAB - ENVIRONMENT CONFIGURATION

# Application
APP_NAME="AI Learning Lab"
DEBUG=true

# Storage Settings ("local" or "supabase")
STORAGE_TYPE=local
VECTOR_DB=faiss

# LLM Providers (Keep keys here - NEVER commit your .env file)
DEFAULT_PROVIDER=gemini

# Google Gemini API (Free tier Flash models)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API (Free tier fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Models (No API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local Embedding Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Supabase (Optional for Persistent Cloud Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=pdf-documents

# Frontend Environment Variable (Local Execution)
VITE_API_BASE_URL=http://localhost:8000
