# ============================================================
# Dockerfile for AI Learning Lab - React & Vite Frontend
# ============================================================
FROM node:20-alpine

WORKDIR /app

# Copy package descriptors
COPY frontend/package*.json ./

# Install npm dependencies
RUN npm install

# Copy frontend source files
COPY frontend/ ./

# Expose Vite dev server port
EXPOSE 5173

# Environment variables for Docker networking
ENV VITE_BACKEND_PROXY_URL=http://backend:8000 \
    HOST=0.0.0.0 \
    PORT=5173

# Run Vite bound to 0.0.0.0
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
